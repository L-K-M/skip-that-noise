{
  "manifest_version": 2,
  "name": "Skip that Noise",
  "version": "0.3.0",
  "description": "Automatically skip songs by specific artists on YouTube Music",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "*://music.youtube.com/*",
    "downloads"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "web_accessible_resources": [
    "import.html",
    "import.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "net.ignorethecode@skip-that-noise",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
